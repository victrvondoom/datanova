# AEGIS-Fraud X Environment Configuration
AEGIS_ENV=development
AEGIS_LOG_LEVEL=INFO
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000
AEGIS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Data Paths
AEGIS_DATA_DIR=datasets
AEGIS_BENCHMARK_DIR=benchmarks
AEGIS_EXPERIMENT_DIR=experiments
AEGIS_REPORT_DIR=reports

# Cost Assumption Defaults (USD)
DEFAULT_INVESTIGATION_COST=15.00
DEFAULT_CUSTOMER_FRICTION_COST=5.00
DEFAULT_INVESTIGATOR_CAPACITY_PER_DAY=100
DEFAULT_VERIFICATION_EFFECTIVENESS=0.92
DEFAULT_MAX_FPR=0.015
